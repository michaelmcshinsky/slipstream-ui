DATABASE_URL="file:./dev.db"
SESSION_SECRET="change-me-in-production-at-least-32-chars"
APP_URL="http://localhost:3002"

# Transactional + newsletter email. `http` posts { from, to, subject, text,
# html?, headers? } to EMAIL_WEBHOOK_URL (any transactional-email gateway);
# `log` is dev-only and forbidden in production. Unset EMAIL_FROM falls back
# to the provider default; set it once a slipstream sending domain is verified.
EMAIL_TRANSPORT="log"
EMAIL_WEBHOOK_URL=""
EMAIL_FROM=""
# Billing provider: "mock" (default, no external calls) or "stripe"
BILLING_PROVIDER="mock"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
