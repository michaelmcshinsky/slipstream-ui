DATABASE_URL="file:./dev.db"
SESSION_SECRET="change-me-in-production-at-least-32-chars"
APP_URL="http://localhost:3002"

# Transactional + newsletter email. `http` posts { from, to, subject, text,
# html?, headers? } to EMAIL_WEBHOOK_URL (any transactional-email gateway);
# `log` is dev-only and forbidden in production. Unset EMAIL_FROM falls back
# to the provider default; set it once a slipstream sending domain is verified.
EMAIL_TRANSPORT="log"
EMAIL_WEBHOOK_URL=""
EMAIL_FROM=""
# Billing provider: "mock" (default, no external calls) or "stripe"
BILLING_PROVIDER="mock"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Consent-gated analytics (optional). The app works without this.
# GA4 requires a DEDICATED property for the dashboard — there is no shared
# fallback, so authenticated-surface traffic never contaminates the docs
# site's funnel. Unset = analytics fully disabled.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Cross-origin browser access to /api/* (comma-separated). Empty = no
# Access-Control-Allow-Origin header; browsers block cross-origin reads.
# Only set this if a separate frontend origin must call the API.
API_ALLOWED_ORIGINS=""

# Rate-limit identity. Unset/false = X-Forwarded-For is ignored and all
# requests share one bucket per route (fail closed). Set "true" ONLY when
# deployed behind a proxy that appends/overwrites XFF; the last hop is used.
TRUST_PROXY=""

# Password breach check (Have I Been Pwned k-anonymity). Enabled by default;
# only the SHA-1 prefix leaves the process. Fails open on network errors.
# Set "off" to disable entirely.
PASSWORD_BREACH_CHECK=""

# Cron endpoints (/api/cron/*). Send as `Authorization: Bearer <secret>`.
# CRON_SECRET is the shared name; NEWSLETTER_CRON_SECRET is still accepted
# for the newsletter job. Unset = cron endpoints reject everything.
CRON_SECRET=""

# Newsletter send window: local-hour range "start-end" (end exclusive) in
# each subscriber's timezone (NewsletterPreferences.timezone). Default
# "0-23" sends whenever the cron runs. To spread sends by timezone, run the
# newsletter cron hourly and set e.g. "8-20"; periodKey dedup makes repeat
# runs queue each subscriber only once.
NEWSLETTER_SEND_WINDOW=""

# CAN-SPAM/CASL: physical postal address rendered in the newsletter footer.
# Required for commercial email compliance; leave empty only while sending
# is disabled. List-Unsubscribe headers are set by the app, but whether the
# EMAIL_WEBHOOK_URL gateway forwards them is provider-dependent.
NEWSLETTER_POSTAL_ADDRESS=""
