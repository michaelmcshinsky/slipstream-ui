# Backend: mock | openai
CHAT_BACKEND=mock

# Mock stream pacing (ms)
MOCK_DELAY_MS=18

# OpenAI-compatible backend
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional gateway/base URL (defaults to https://api.openai.com/v1)
OPENAI_BASE_URL=

# Commercial licence checkout (Stripe Payment Link or hosted checkout)
NEXT_PUBLIC_CHECKOUT_URL=

# Optional consent-gated analytics beacon endpoint
NEXT_PUBLIC_ANALYTICS_ENDPOINT=
