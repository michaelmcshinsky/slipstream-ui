{
  "name": "slipstream-ai-chat-starter",
  "version": "0.1.1",
  "private": true,
  "description": "AI Chat Starter - a complete, backend-agnostic chat surface built with Slipstream UI",
  "scripts": {
    "dev": "next dev -p 3200",
    "build": "next build",
    "start": "next start -p 3200",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app src --ext .ts,.tsx",
    "test": "vitest run"
  },
  "dependencies": {
    "@slipstream-ui/ai": "workspace:*",
    "@slipstream-ui/i18n": "workspace:*",
    "@slipstream-ui/core": "workspace:*",
    "@slipstream-ui/themes": "workspace:*",
    "next": "^16.4.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@slipstream-ui/eslint-config": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.1.0",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
