{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slipstream-ui-docs",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "slipstream-ui-docs"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  // Attach the docs domain in the Cloudflare dashboard, or uncomment:
  // "routes": [{ "pattern": "ui.slipstream.dev", "custom_domain": true }],
  "vars": {}
}
