{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name of the Workers Builds project connected to this
  // repo (`slipstream-ui`). Workers Builds overrides a mismatched name at deploy
  // time, which leaves the WORKER_SELF_REFERENCE binding pointing at a Worker
  // that does not exist.
  "name": "slipstream-ui",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "slipstream-ui"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  // Attach the docs domain in the Cloudflare dashboard, or uncomment:
  // "routes": [{ "pattern": "ui.slipstream.dev", "custom_domain": true }],
  "vars": {}
}
