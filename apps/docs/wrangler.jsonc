{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name of the Workers Builds project connected to this
  // repo (`slipstream-ui`). Workers Builds overrides a mismatched name at deploy
  // time, which leaves the WORKER_SELF_REFERENCE binding pointing at a Worker
  // that does not exist.
  "name": "slipstream-ui",
  // `worker.ts` wraps the OpenNext handler with the anonymous HTML cache.
  "main": "./worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "slipstream-ui"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  // Custom domains for the docs site. `custom_domain` makes Wrangler create the
  // proxied DNS record and managed certificate, so the pair lives in version
  // control instead of being hand-attached in the dashboard. `www` is part of the
  // Worker only so the app can answer it with a canonical redirect to the apex
  // (see `redirects()` in next.config.mjs).
  "routes": [
    { "pattern": "slipstreamui.com", "custom_domain": true },
    { "pattern": "www.slipstreamui.com", "custom_domain": true }
  ],
  "vars": {}
}
