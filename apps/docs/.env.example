# Consent-gated analytics (optional). The site works without these.
# Nothing loads until a visitor accepts cookies; see lib/analytics.ts.
#
# Default: Google Analytics 4 with the measurement ID in lib/analytics.ts.
# Set NEXT_PUBLIC_GA_MEASUREMENT_ID to send a preview or fork to another
# property.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
#
# Alternative: point at a Plausible-style script (takes precedence over GA4).
# Set both to a script + domain to start collecting the events defined in
# lib/analytics.ts.
NEXT_PUBLIC_ANALYTICS_SRC=
NEXT_PUBLIC_ANALYTICS_DOMAIN=
