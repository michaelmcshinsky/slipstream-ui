    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@slipstream-ui/eslint-config": "workspace:*",
    "@slipstream-ui/tailwind-config": "workspace:*",
    "@slipstream-ui/typescript-config": "workspace:*",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.16",
    "axe-core": "^4.14.0",
    "chrome-launcher": "^1.2.2",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.1.0",
    "lighthouse": "^13.6.0",
    "playwright-core": "^1.64.1",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.15",
    "typescript": "^5.3.3"
