{
  "name": "@slipstream-ui/i18n",
  "version": "0.2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michaelmcshinsky/slipstream-ui.git",
    "directory": "packages/i18n"
  },
  "description": "Typed localization runtime for Slipstream UI apps",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react-entry.d.ts",
      "import": "./dist/react-entry.mjs",
      "require": "./dist/react-entry.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@slipstream-ui/eslint-config": "workspace:*",
    "@slipstream-ui/typescript-config": "workspace:*",
    "@slipstream-ui/vitest-config": "workspace:*",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "eslint": "^8.56.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.3",
    "vitest": "^5.0.5"
  }
}
