{
  "name": "@slipstream-ui/mcp-server",
  "version": "0.0.1",
  "description": "MCP server for Slipstream UI component manifests",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "slipstream-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
