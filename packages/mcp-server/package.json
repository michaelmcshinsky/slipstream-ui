{
  "name": "@slipstream-ui/mcp-server",
  "version": "0.2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michaelmcshinsky/slipstream-ui.git",
    "directory": "packages/mcp-server"
  },
  "description": "MCP server for Slipstream UI component manifests",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "slipstream-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@slipstream-ui/eslint-config": "workspace:*",
    "@slipstream-ui/registry": "workspace:*",
    "@slipstream-ui/typescript-config": "workspace:*",
    "@slipstream-ui/vitest-config": "workspace:*",
    "@types/node": "^20.10.0",
    "eslint": "^8.56.0",
    "jsdom": "^30.1.3",
    "tsup": "^8.0.0",
    "typescript": "^5.3.3",
    "vitest": "^5.0.5"
  }
}
