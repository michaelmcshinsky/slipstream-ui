{
  "id": "password-input",
  "name": "PasswordInput",
  "tier": "molecule",
  "description": "Password field with an accessible show/hide toggle (aria-pressed), built on Input.",
  "designIntent": "Users mistype passwords; a reveal toggle reduces failed sign-ins. The toggle must be a real button with a pressed state and a proper label so it is not a mystery control.",
  "props": [
    {
      "name": "showLabel",
      "type": "string",
      "required": false,
      "defaultValue": "Show password",
      "description": "Accessible label while hidden."
    },
    {
      "name": "hideLabel",
      "type": "string",
      "required": false,
      "defaultValue": "Hide password",
      "description": "Accessible label while visible."
    }
  ],
  "examples": [
    {
      "title": "Sign-in field",
      "code": "<PasswordInput aria-label=\"Password\" autoComplete=\"current-password\" />",
      "description": "Input props pass through."
    }
  ],
  "antiPatterns": [
    {
      "title": "Don't reveal by default",
      "explanation": "Start masked; reveal is user-initiated.",
      "example": "// Avoid: type=\"text\" for a password\n<Input type=\"text\" aria-label=\"Password\" />\n\n// Prefer\n<PasswordInput aria-label=\"Password\" />"
    }
  ],
  "accessibility": [
    {
      "feature": "Toggle semantics",
      "implementation": "Button with aria-pressed and Show/Hide labels",
      "userRequirements": "Keep both labels descriptive"
    }
  ],
  "contentGuidelines": [
    {
      "contentType": "Labels",
      "guidelines": [
        "Verb-first toggle labels"
      ],
      "goodExamples": [
        "Show password"
      ],
      "badExamples": [
        "Eye"
      ]
    }
  ],
  "compositionRules": [
    {
      "component": "FormField",
      "relationship": "Wrap for label/hint/error wiring",
      "example": "<FormField id=\"pw\" label=\"Password\"><PasswordInput /></FormField>"
    }
  ],
  "relatedComponents": [
    "Input",
    "FormField",
    "InputGroup"
  ],
  "package": "@slipstream-ui/core",
  "importPath": "@slipstream-ui/core",
  "version": "0.1.0",
  "sourceDir": "password-input",
  "exportName": "PasswordInput"
}
