{
  "name": "@slipstream-ui/core",
  "version": "0.7.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michaelmcshinsky/slipstream-ui.git",
    "directory": "packages/core"
  },
  "description": "Core UI components for Slipstream UI",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./styles-full.css": "./dist/styles-full.css",
    "./*": {
      "types": "./dist/src/components/*/index.d.ts",
      "import": "./dist/src/components/*/index.mjs",
      "require": "./dist/src/components/*/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup && tsup --config tsup.modules.config.ts && node scripts/fix-module-extensions.mjs && tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/manifests','dist/manifests',{recursive:true})\" && tailwindcss -c tailwind.config.js -i src/styles.css -o dist/styles.css --minify && tailwindcss -c tailwind.full.config.js -i src/styles-full.css -o dist/styles-full.css --minify",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-slot": "^1.0.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@slipstream-ui/eslint-config": "workspace:*",
    "@slipstream-ui/tailwind-config": "workspace:*",
    "@slipstream-ui/typescript-config": "workspace:*",
    "@slipstream-ui/vitest-config": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.0.0",
    "eslint": "^8.56.0",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "tsup": "^9.0.0",
    "typescript": "^5.3.3",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  }
}
