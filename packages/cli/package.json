{
  "name": "@slipstream-ui/cli",
  "version": "0.0.1",
  "description": "CLI tool for Slipstream UI component installation and management",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "slipstream-ui": "./dist/index.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^12.0.0",
    "fs-extra": "^11.2.0",
    "ora": "^5.4.1"
  },
  "devDependencies": {
    "@slipstream-ui/eslint-config": "workspace:*",
    "@slipstream-ui/registry": "workspace:*",
    "@slipstream-ui/typescript-config": "workspace:*",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.10.0",
    "eslint": "^8.56.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.3",
    "vitest": "^3.0.0"
  }
}
