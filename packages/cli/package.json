{
  "name": "@slipstream-ui/cli",
  "version": "0.2.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michaelmcshinsky/slipstream-ui.git",
    "directory": "packages/cli"
  },
  "description": "CLI tool for Slipstream UI component installation and management",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "slipstream-ui": "./dist/index.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^12.0.0",
    "fs-extra": "^11.4.1",
    "ora": "^5.4.1"
  },
  "devDependencies": {
    "@slipstream-ui/eslint-config": "workspace:*",
    "@slipstream-ui/registry": "workspace:*",
    "@slipstream-ui/typescript-config": "workspace:*",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.10.0",
    "eslint": "^8.56.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.3",
    "vitest": "^5.0.5"
  }
}
