{
  "name": "@slipstream-ui/themes",
  "version": "0.5.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michaelmcshinsky/slipstream-ui.git",
    "directory": "packages/themes"
  },
  "description": "Theming system for Slipstream UI with createTheme() and presets",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./tailwind-v4.css": "./tailwind-v4.css",
    "./tailwind-preset": "./tailwind-preset.cjs",
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "src",
    "tailwind-v4.css",
    "tailwind-preset.cjs"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup && node scripts/build-css.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "dependencies": {
    "tailwindcss-animate": "^1.0.7"
  },
  "peerDependencies": {
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "@slipstream-ui/eslint-config": "workspace:*",
    "@slipstream-ui/typescript-config": "workspace:*",
    "eslint": "^8.56.0",
    "tsup": "^9.0.0",
    "typescript": "^5.3.3"
  }
}