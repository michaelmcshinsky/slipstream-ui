{
  "name": "slipstream-ui",
  "version": "0.0.1",
  "private": true,
  "description": "The AI-first React component library — your AI already knows how to use it.",
  "license": "MIT",
  "scripts": {
    "dev": "turbo run dev",
    "dev:docs": "turbo run dev --filter=@slipstream-ui-docs",
    "dev:playground": "turbo run dev --filter=slipstream-ui-playground",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "validate:manifests": "tsx scripts/validate-manifests.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish --provenance"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^2.27.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "tsx": "^4.7.0",
    "turbo": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}
